{% from 'github/workflows/appimage-build.sh.j2' import build %}
{% from 'github/workflows/pyinstaller-test.sh.j2' import test_bash %}
jobs:
  build:
    permissions:
{% if settings.private %}
      actions: 'write'
{% endif %}
      attestations: 'write'
      contents: 'read'
      id-token: 'write'
    runs-on: ${{ '{{' }} matrix.system.image }}
    steps:
      - uses: 'actions/checkout@{{ github_latest_action_sha('actions', 'checkout') }}'
        with:
          persist-credentials: false
{% if settings.package_manager == 'uv' %}
      - name: 'Install yq'
        run: 'pipx install yq'
      - name: 'Install uv'
        uses: 'astral-sh/setup-uv@{{ github_latest_action_sha('astral-sh', 'setup-uv') }}'
        with:
          enable-cache: false
{% else %}
      - name: 'Install Poetry'
        run: 'pipx install poetry yq'
{% endif %}
      - name: 'Set up Python'
        uses: 'actions/setup-python@{{ github_latest_action_sha('actions', 'setup-python') }}'
        with:
{% if settings.package_manager != 'uv' %}
          cache: 'poetry'
{% endif %}
          python-version: '3.13'
{% if settings.github.workflows.appimage.apt_packages %}
      - name: 'Install dependencies'
        run: 'sudo apt-get update && sudo apt-get install -y {{ settings.github.workflows.appimage.apt_packages | join(" ") }}'
{% endif %}
{% if settings.package_manager == 'uv' %}
      - name: 'Install dependencies (uv)'
        run: |
          uv sync{{ ' ' + settings.appimage.uv_sync_args | join(' ') if settings.appimage.uv_sync_args else '' }}
          uv pip install python-appimage
          wget -O generic.svg 'https://raw.githubusercontent.com/KDE/breeze-icons/refs/heads/master/icons/preferences/32/preferences-other.svg'
        shell: 'bash'
{% else %}
      - name: 'Install dependencies (Poetry)'
        run: |
          poetry install
          poetry run -- pip install python-appimage
          wget -O generic.svg 'https://raw.githubusercontent.com/KDE/breeze-icons/refs/heads/master/icons/preferences/32/preferences-other.svg'
        shell: 'bash'
{% endif %}
      - name: 'Build with python-appimage'
        env:
          GH_TOKEN: '${{ '{{' }} github.token }}'
        run: |
          {{ build(settings) | indent(10) | trim }}
        shell: 'bash'
      - name: 'Test binary'
        run: |
          {{ test_bash(settings.appimage.test_commands) | indent(10) | trim }}
      - name: 'Upload Artifacts'
        uses: 'actions/upload-artifact@{{ github_latest_action_sha('actions', 'upload-artifact') }}'
        with:
          if-no-files-found: error
          name: {{ settings.github_project_name }}-binaries-linux-${{ '{{' }} matrix.system.arch }}
          path: |
            dist/*
  {% if not settings.private %}
      - name: 'Generate SBOM'
        uses: 'anchore/sbom-action@{{ github_latest_action_sha('anchore', 'sbom-action') }}'
        env:
          SYFT_SOURCE_NAME: '{{ settings.github_project_name }}'
          SYFT_SOURCE_VERSION: ${{ '{{' }} github.ref_name }}
        with:
          path: 'dist/'
          output-file: 'sbom.spdx.json'
          upload-artifact: false
      - name: 'Attest'
        uses: 'actions/attest@{{ github_latest_action_sha('actions', 'attest') }}'
        with:
          subject-path: 'dist/*.AppImage'
      - name: 'Attest SBOM'
        uses: 'actions/attest@{{ github_latest_action_sha('actions', 'attest') }}'
        with:
          subject-path: 'dist/*.AppImage'
          sbom-path: 'sbom.spdx.json'
  {% endif %}
    strategy:
      matrix:
        system:
{% if not settings.private %}
          - { arch: aarch64, image: ubuntu-24.04-arm }
{% endif %}
          - { arch: x86_64, image: ubuntu-latest }
  release-assets:
    concurrency:
      group: release-assets-${{ '{{' }} github.ref }}
      queue: max
    if: github.ref_type == 'tag'
    needs:
      - 'build'
    permissions:
      contents: 'write'
    runs-on: 'ubuntu-latest'
    steps:
      - name: 'Download build artifacts'
        uses: 'actions/download-artifact@{{ github_latest_action_sha('actions', 'download-artifact') }}'
        with:
          merge-multiple: true
          path: '_release_assets'
          pattern: {{ settings.github_project_name }}-binaries-linux-*
      - name: 'Create or update draft release'
        env:
          GH_REPO: ${{ '{{' }} github.repository }}
          GH_TOKEN: ${{ '{{' }} github.token }}
        shell: 'bash'
        run: |
          gh release view "$GITHUB_REF_NAME" >/dev/null 2>&1 ||
            gh release create "$GITHUB_REF_NAME" --draft --notes ''
          shopt -s nullglob
          assets=(_release_assets/*)
          if [ -z "${assets[0]-}" ]; then
            echo 'No build artifacts to attach.'
            exit 0
          fi
          gh release upload "$GITHUB_REF_NAME" "${assets[@]}" --clobber
name: 'AppImage'
'on':
  push:
    branches:
      - 'master'
    paths:
{% for mod in settings.modules %}
      - '{{ mod | replace('.', '/') }}/**'
{% endfor %}
      - '.github/workflows/appimage.yml'
      - 'pyproject.toml'
      - 'uv.lock'
      - 'poetry.lock'
    tags:
      - 'v*.*.*'
permissions: {}
